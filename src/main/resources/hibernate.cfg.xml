<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>

        <!-- Conexión a la base de datos (H2 en archivo, para inspeccionarla después) -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:file:./data/hibernate-demo</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <!--
            update: Hibernate compara las entidades @Entity contra las tablas
            existentes y genera automáticamente el DDL (CREATE TABLE / ALTER TABLE)
            que haga falta. Aquí es literalmente donde ocurre lo que pide el desafío:
            "la creación automática del esquema a partir de las entidades".
        -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Para que la demo se vea: Hibernate imprime en consola el SQL generado -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Registramos la entidad que Hibernate debe mapear -->
        <mapping class="sv.edu.udb.domain.Curso"/>

    </session-factory>
</hibernate-configuration>